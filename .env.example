# Copy to .env and fill in. Read by pydantic-settings (app/config.py); every
# Settings field maps 1:1 to a variable here. This file is the single source of
# truth for configuration — add new fields here first, commented.

# ── App ──
ENVIRONMENT=local                # dev | local | test | prod (gates docs, dev routes)
LOG_LEVEL=INFO

# Shared secret: sent as X-API-Key by the frontend (entered on the login screen)
# and required by all /api/v1 routes, including the agent SSE stream.
APP_API_KEY=change-me

# ── Upstream reporting API (called live, directly — no cache/mock layer) ──
UPSTREAM_BASE_URL=https://ai-homework-production-2423.up.railway.app
UPSTREAM_TOKEN=any-token         # upstream accepts any bearer token (probed)

# ── LLM / agent (OpenRouter, OpenAI-compatible) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.6-plus      # confirmed live 2026-07-25 (tool calling verified)
LLM_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=20          # Tool Steps = model calls; final step runs with tools omitted
